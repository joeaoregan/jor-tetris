{
  "name": "Angular-Tetris",
  "description": "A Tetris game built with Angular",
  "homepage": "https://github.com/joeoregan/Angular-Tetris#readme",
  "author": "Joe O'Regan",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build:gh": "ng build --configuration production --base-href /Angular-Tetris/",
    "deploy:gh": "angular-cli-ghpages --dir=dist/Angular-Tetris/browser --branch=gh-pages --repo=https://github.com/JoeORegan/Angular-Tetris.git"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "express": "^5.2.1",
    "path": "^0.12.7",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/language-service": "^22.1.1",
    "@types/node": "~26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "browserslist": "^4.28.1",
    "eslint": "^10.1.0",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.2"
  },
  "overrides": {
